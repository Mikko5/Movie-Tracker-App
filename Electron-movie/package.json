{
  "name": "electron-movie-json-demo",
  "version": "1.0.0",
  "main": "src/core/main.js",
  "description": "Electron app to read, modify, and save a JSON file.",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron . --no-sandbox",
    "start:prod": "electron . --no-sandbox",
    "seed": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/seed.js",
    "seeds": "npm run seed",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/jest/bin/jest.js",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/jest/bin/jest.js --watch",
    "test:coverage": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/jest/bin/jest.js --coverage",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.movie.tracker",
    "productName": "Movie Tracker",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mikko5",
        "repo": "Movie-Tracker-App"
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-jest": "^30.2.0",
    "cross-env": "^10.1.0",
    "electron": "^29.3.0",
    "electron-builder": "^26.0.12",
    "electron-reloader": "^1.2.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^11.8.1",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "node-fetch": "^3.3.2"
  }
}
