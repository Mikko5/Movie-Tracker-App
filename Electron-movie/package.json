{
  "name": "electron-movie-json-demo",
  "version": "1.0.0",
  "main": "src/core/main.js",
  "description": "Electron app to read, modify, and save a JSON file.",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "start:prod": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.movie.tracker",
    "productName": "Movie Tracker",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^29.3.0",
    "electron-builder": "^26.0.12",
    "electron-reloader": "^1.2.3"
  },
  "dependencies": {
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.1",
    "node-fetch": "^3.3.2"
  }
}